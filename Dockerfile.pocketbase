# Image d'exécution minimale pour PocketBase v0.40.5
FROM alpine:3.21

ARG PB_VERSION=0.40.5

RUN apk add --no-cache \
    unzip \
    ca-certificates \
    wget

WORKDIR /pb

# Téléchargement et vérification du binaire officiel PocketBase
RUN wget -q https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip \
    && unzip pocketbase_${PB_VERSION}_linux_amd64.zip \
    && rm pocketbase_${PB_VERSION}_linux_amd64.zip \
    && chmod +x /pb/pocketbase

# Intégration des migrations et des hooks applicatifs
COPY pb_migrations /pb/pb_migrations
COPY pb_hooks /pb/pb_hooks

# Répertoire de données monté sur volume persistant en production
RUN mkdir -p /pb/pb_data

EXPOSE 8090

ENTRYPOINT ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090", "--dir=/pb/pb_data", "--migrationsDir=/pb/pb_migrations", "--hooksDir=/pb/pb_hooks"]
